{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Little Check feed v2",
  "type": "object",
  "required": ["schema_version", "generated_at", "items"],
  "properties": {
    "schema_version": {"const": 2},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "items": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "content", "source", "published_at"],
        "properties": {
          "id": {"type": "string", "pattern": "\\S"},
          "title": {"type": "string", "pattern": "\\S"},
          "summary": {"type": "string"},
          "content": {"type": "string"},
          "platform": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "url": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://[^/?#@]+(?:[/?#]|$)"},
          "published_at": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
